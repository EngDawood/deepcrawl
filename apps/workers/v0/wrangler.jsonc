{
  "name": "deepcrawl-api-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-05",
  "compatibility_flags": ["nodejs_compat"],
  "placement": { "mode": "smart" },
  "vars": {
    "AUTH_MODE": "jwt",
    "ENABLE_ACTIVITY_LOGS": false,
    "JWT_ISSUER": "",
    "JWT_AUDIENCE": "",
    "ENABLE_API_RATE_LIMIT": false,
    "WORKER_NODE_ENV": "production"
  },
  "kv_namespaces": [
